flowchart TD
    subgraph SharedFoundation["Shared Foundation"]
        A1["Source Code Input"] --> B1["Boilerplate And Whitespace Normalizer"]
        B1 --> C1["Tree Sitter AST Parser"]
        C1 --> D1["12 State Sequence Mapper"]
    end

    subgraph PairwisePlagiarism["Task: pairwise_plagiarism (2 Files)"]
        D1 --> P1["Smoothed Markov Tensor (alpha 0.01, abs diff)"]
        D1 --> P2["Unsmoothed Markov Tensor (alpha 0.0, signed diff)"]
        B1 --> P3["Character N Gram TF IDF Baseline"]
        P1 --> PM1["Calibrated Pairwise LightGBM (Default)"]
        P2 --> PM2["NumPy Pairwise CNN (Selectable)"]
        P3 --> PM3["TF IDF Cosine Baseline"]
        PM1 --> PR["models/pairwise_plagiarism/manifest.json"]
        PM2 --> PR
        PM3 --> PR
    end

    subgraph AiPlagiarism["Task: ai_plagiarism (1 File)"]
        D1 --> AI1["Single File 12x12 Markov Matrix"]
        B1 --> AI2["Normalized Single File Source"]
        AI1 --> AIR["models/ai_plagiarism/manifest.json"]
        AI2 --> AIR
    end

    subgraph ServiceLayer["Presentation"]
        PR --> H1["FastAPI: POST /predict/pairwise_plagiarism (+ /predict)"]
        AIR --> H2["FastAPI: POST /predict/ai_plagiarism"]
        H1 --> I1["Streamlit UI: Pairwise Plagiarism Mode"]
        H2 --> I2["Streamlit UI: AI Plagiarism Mode"]
    end
